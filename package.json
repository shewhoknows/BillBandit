{
  "name": "billbandit-platform",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "npm --workspace apps/api run dev",
    "build": "npm --workspace apps/api run build",
    "start": "npm --workspace apps/api run start",
    "lint": "oxlint -c .oxlintrc.json apps/api",
    "typecheck": "npm --workspace apps/api run typecheck",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:generate": "npm --workspace apps/api run db:generate",
    "db:push": "npm --workspace apps/api run db:push",
    "dev:server": "npm --workspace apps/api run dev:server",
    "dev:data": "npm --workspace apps/api run dev:data --",
    "review:reset": "npm --workspace apps/api run review:reset --",
    "db:studio": "npm --workspace apps/api run db:studio",
    "review:teardown": "npm --workspace apps/api run review:teardown --",
    "lint:legacy": "npm --workspace apps/api run lint",
    "fmt": "oxfmt --check",
    "check": "bun node_modules/typescript7/bin/tsc -p apps/api/tsconfig.json --noEmit --incremental false",
    "build:ci": "bun run --bun --cwd apps/api build"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript7": "npm:typescript@7.0.2"
  }
}
