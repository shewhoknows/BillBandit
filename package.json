{
  "name": "billbandit-platform",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/api dev",
    "build": "bun run --cwd apps/api build",
    "start": "bun run --cwd apps/api start",
    "lint": "oxlint -c .oxlintrc.json apps/api",
    "typecheck": "bun run --cwd apps/api typecheck",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:push": "bun run --cwd apps/api db:push",
    "dev:server": "bun run --cwd apps/api dev:server",
    "dev:data": "bun run --cwd apps/api dev:data",
    "review:reset": "bun run --cwd apps/api review:reset",
    "db:studio": "bun run --cwd apps/api db:studio",
    "review:teardown": "bun run --cwd apps/api review:teardown",
    "lint:legacy": "bun run --cwd apps/api lint",
    "fmt": "oxfmt --check",
    "check": "bun node_modules/typescript7/bin/tsc -p apps/api/tsconfig.json --noEmit --incremental false",
    "build:ci": "bun run --bun --cwd apps/api build"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript7": "npm:typescript@7.0.2"
  }
}
