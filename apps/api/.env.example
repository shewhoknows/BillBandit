# ================================================
# BillBandit API – Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# Database (Railway PostgreSQL – auto-populated by Railway)
DATABASE_URL="postgresql://user:password@host:5432/billbandit?schema=public"

# Mobile auth (Sign in with Apple + Bearer JWT)
MOBILE_JWT_SECRET="generate-with-openssl-rand-base64-32"

# Apple Sign In token audience
IOS_BUNDLE_ID="com.billbandit.app"
# Alternative name used by some routes:
APPLE_CLIENT_ID="com.billbandit.app"

# Optional: Pusher for settlement realtime invalidation
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us2"

# Dev/QA only: bypass Apple JWKS verification
# MOBILE_AUTH_MOCK_APPLE_SUBJECT="mock-apple-subject"
# MOBILE_AUTH_MOCK_APPLE_EMAIL="mock@example.com"

# Optional: run prisma seed on container start (Railway)
# SEED_ON_START="true"
